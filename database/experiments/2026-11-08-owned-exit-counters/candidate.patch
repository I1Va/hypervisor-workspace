+static void OwnedEvent(UINT32 Reason, UINT32 Apic, UINT32 Owner)
+{
+	HvStatsNoteOwnedExit(Reason, Apic, Owner);
+	ExpectEvent(Reason, Apic);
+}
+
+static void TestOwnedBoundaries(void)
+{
+	static const UINT32 Apics[] = {0, 0, 63, 64, 255, UINT32_MAX};
+	static const UINT32 Reasons[] = {0, 71, 72, UINT32_MAX};
+	Reset();
+	for (UINT32 Owner = 0; Owner < 64; ++Owner)
+	{
+		assert((uintptr_t)&g_HvOwnedExitShards[Owner] % 64 == 0);
+		UINT32 Apic = Apics[Owner % 6];
+		for (unsigned R = 0; R < 4; ++R)
+		{
+			OwnedEvent(Reasons[R], Apic, Owner);
+			Check();
+		}
+		assert(g_HvOwnedExitShards[Owner].Valid == 1);
+		assert(g_HvOwnedExitShards[Owner].ApicId == Apic);
+	}
+	/* Invalid owners never alias an owned slot, including zero/sentinel APIC. */
+	OwnedEvent(0, 0, 64);
+	OwnedEvent(71, 63, 65);
+	OwnedEvent(72, 64, UINT32_MAX);
+	OwnedEvent(UINT32_MAX, UINT32_MAX, UINT32_MAX);
+	/* A changed label falls back; old counts and immutable metadata survive. */
+	OwnedEvent(48, 37, 0);
+	assert(g_HvOwnedExitShards[0].ApicId == 0);
+	OwnedEvent(48, 0, 0);
+	Check();
+}
+
+typedef struct {
+	UINT32 Apic;
+	UINT32 Owner;
+	int Generic;
+	int Publication;
+} OWNED_WRITER;
+
+static void *WriteOwnedExits(void *Argument)
+{
+	OWNED_WRITER *Writer = Argument;
+	while (!__atomic_load_n(&Start, __ATOMIC_ACQUIRE)) { }
+	for (unsigned Index = 0; Index < ITERATIONS; ++Index)
+	{
+		UINT32 Reason = Writer->Publication ? Writer->Apic : ThreadReasons[Index % 5];
+		if (Writer->Generic) HvStatsNoteExit(Reason, Writer->Apic);
+		else HvStatsNoteOwnedExit(Reason, Writer->Apic, Writer->Owner);
+	}
+	__atomic_add_fetch(&Done, 1, __ATOMIC_RELEASE);
+	return NULL;
+}
+
+static void TestOwnedConcurrent(int Fallback, int Publication)
+{
+	/* Eight owned writers with repeated APIC 0/7; a ninth generic writer
+	 * simultaneously updates APIC 0 using entirely separate RMW storage. */
+	static const UINT32 Apics[THREAD_COUNT] = {0, 0, 7, 7, 63, 64, 255, UINT32_MAX};
+	pthread_t Threads[THREAD_COUNT + 1];
+	OWNED_WRITER Writers[THREAD_COUNT + 1];
+	HV_STATS Previous = {0}, Stats;
+	Reset();
+	__atomic_store_n(&Start, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&Done, 0, __ATOMIC_RELAXED);
+	for (unsigned Thread = 0; Thread <= THREAD_COUNT; ++Thread)
+	{
+		Writers[Thread].Apic = Publication ? (Thread % 4) * 7 :
+		    (Thread == THREAD_COUNT ? 0 : Apics[Thread]);
+		Writers[Thread].Publication = Publication;
+		/* All fallback writers share the same >=64 owner, and two share
+		 * the generic writer's APIC shard. Both paths must retain every event. */
+		Writers[Thread].Owner = Fallback ? 64 : Thread;
+		Writers[Thread].Generic = Thread == THREAD_COUNT;
+		assert(pthread_create(&Threads[Thread], NULL, WriteOwnedExits, &Writers[Thread]) == 0);
+	}
+	__atomic_store_n(&Start, 1, __ATOMIC_RELEASE);
+	do
+	{
+		HvStatsFill(&Stats);
+		CheckLive(&Previous, &Stats);
+		Previous = Stats;
+		if (Publication)
+		{
+			UINT64 Total = 0;
+			for (unsigned Core = 0; Core < 64; ++Core)
+			{
+				assert(Stats.CoreExits[Core] == Stats.ExitReason[Core]);
+				Total += Stats.CoreExits[Core];
+			}
+			assert(Total == Stats.TotalExits);
+		}
+	} while (__atomic_load_n(&Done, __ATOMIC_ACQUIRE) != THREAD_COUNT + 1);
+	for (unsigned Thread = 0; Thread <= THREAD_COUNT; ++Thread)
+	{
+		assert(pthread_join(Threads[Thread], NULL) == 0);
+		for (unsigned Index = 0; Index < ITERATIONS; ++Index)
+			ExpectEvent(Publication ? Writers[Thread].Apic : ThreadReasons[Index % 5],
+			    Writers[Thread].Apic);
+	}
+	for (unsigned Owner = 0; Owner < 64; ++Owner)
+	{
+		assert(g_HvOwnedExitShards[Owner].Valid == (UINT32)(!Fallback && Owner < THREAD_COUNT));
+		if (!Fallback && Owner < THREAD_COUNT)
+			assert(g_HvOwnedExitShards[Owner].ApicId == Writers[Owner].Apic);
+	}
+	Check();
+}
