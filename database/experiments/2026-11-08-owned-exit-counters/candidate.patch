 	TestConcurrent(1); /* Same-shard writers: atomic RMW must not lose increments. */
-	puts("hv_stats_test: PASS (ABI, boundaries, totals, atomic snapshots, concurrency)");
+	TestOwnedBoundaries();
+	TestOwnedConcurrent(0, 0); /* Distinct owners, duplicate APICs, generic overlap. */
+	TestOwnedConcurrent(1, 0); /* Shared owner fallback retains atomic RMW semantics. */
+	TestOwnedConcurrent(0, 1); /* Live publication: reason == APIC, exact view agreement. */
+	puts("hv_stats_test: PASS (ABI, generic RMW, owned counters, fallback, publication, concurrency)");
 	return 0;
 }
