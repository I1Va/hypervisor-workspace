+VOID
+HvStatsNoteOwnedExit(
+	UINT32 BasicExitReason,
+	UINT32 ApicId,
+	UINT32 OwnerIndex
+	)
+{
+	if (OwnerIndex >= HV_STATS_CORE_COUNT)
+	{
+		HvStatsNoteExit(BasicExitReason, ApicId);
+		return;
+	}
+
+	HV_STATS_OWNED_EXIT_SHARD *Shard = &g_HvOwnedExitShards[OwnerIndex];
+	if (!__atomic_load_n(&Shard->Valid, __ATOMIC_RELAXED))
+	{
+		Shard->ApicId = ApicId;
+		/* Publish immutable metadata before this owner's first event. */
+		__atomic_store_n(&Shard->Valid, 1, __ATOMIC_RELEASE);
+	}
+	else if (Shard->ApicId != ApicId)
+	{
+		/* Misuse must not relabel prior events or discard this event. */
+		HvStatsNoteExit(BasicExitReason, ApicId);
+		return;
+	}
+	volatile UINT64 *Counter = BasicExitReason < HV_STATS_REASON_COUNT
+	    ? &Shard->Counts.ExitReason[BasicExitReason] : &Shard->Counts.OtherReason;
+	UINT64 Count = __atomic_load_n(Counter, __ATOMIC_RELAXED);
+	__atomic_store_n(Counter, Count + 1, __ATOMIC_RELAXED);
+}
